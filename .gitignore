# ==========================================
# CUSTOM PROJECT RULES (Added manually)
# ==========================================

# 0. Ignore local-only docs (not for upload)
CLAUDE.md

# 1. Generated data — pipeline regenerates these; only the .gitkeep marker is tracked
data/processed/*
!data/processed/.gitkeep
data/ate_output/*
!data/ate_output/.gitkeep

# 2. Saved models (large .pth files; only the .gitkeep marker is tracked)
model/save/*
!model/save/.gitkeep
*.pth
*.pt
saved_models/

# 3. PyABSA-side fallout if run() is invoked outside the chdir context (defensive)
checkpoints/
checkpoints.json
run/

# 4. IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
